{
  "name": "teslam2eedak-koffee-kulture",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "./scripts/tmux-dev.sh next",
    "dev:env": "./scripts/tmux-dev.sh stripe",
    "dev:all": "./scripts/tmux-dev.sh all",
    "dev:stop": "./scripts/tmux-dev.sh stop",
    "dev:no-tmux": "next dev --webpack",
    "dev:no-tmux:all": "concurrently -n \"stripe,next\" -c \"green,magenta\" \"bun stripe:listen\" \"next dev --webpack\"",
    "build": "next build --webpack",
    "start": "next start --webpack",
    "lint": "eslint",
    "check": "tsc --noEmit",
    "format": "prettier --write .",
    "db:clear": "find ./sqlite-data -mindepth 1 -not -name '.gitkeep' -delete",
    "payload:types": "payload generate:types",
    "payload:importmap": "payload generate:importmap",
    "stripe:listen": "stripe listen --forward-to localhost:3000/api/stripe/webhook --skip-verify",
    "stripe:login": "stripe login",
    "pwa:generate": "pwa-assets-generator --config ./pwa-assets.config.ts",
    "generate:secret": "node -e \"console.log(require('crypto').randomBytes(32).toString('hex'))\"",
    "api:types": "bunx openapi-typescript http://localhost:3000/api/openapi.json -o src/lib/api/types.ts",
    "test": "vitest run tests/",
    "test:watch": "vitest tests/",
    "test:routes": "vitest run tests/routes/"
  },
  "dependencies": {
    "@daveyplate/better-auth-ui": "^3.3.15",
    "@dicebear/core": "^9.3.1",
    "@dicebear/notionists": "^9.3.1",
    "@hookform/resolvers": "^5.2.2",
    "@payloadcms/email-resend": "^3.80.0",
    "@stripe/react-stripe-js": "^5.6.0",
    "@stripe/stripe-js": "^8.7.0",
    "@tailwindcss/typography": "^0.5.19",
    "@types/qrcode": "^1.5.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "effect": "^3.21.0",
    "framer-motion": "^12.33.0",
    "leaflet": "^1.9.4",
    "leaflet-draw": "^1.0.4",
    "leaflet.fullscreen": "^5.3.0",
    "leaflet.markercluster": "^1.5.3",
    "lenis": "^1.3.17",
    "lucide-react": "^0.564.0",
    "motion": "^12.34.0",
    "next": "^16.1.6",
    "next-themes": "^0.4.6",
    "openapi-fetch": "^0.17.0",
    "openapi-typescript": "^7.13.0",
    "payload-oapi": "^0.2.5",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.71.2",
    "react-leaflet": "^5.0.0",
    "react-leaflet-markercluster": "^5.0.0-rc.0",
    "recharts": "^3.8.0",
    "resend": "^6.9.4",
    "saasignal": "^0.9.35",
    "shiki": "^3.22.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@better-auth/passkey": "^1.4.18",
    "@eslint/eslintrc": "eslint/eslintrc",
    "@payloadcms/db-sqlite": "^3.75.0",
    "@payloadcms/next": "^3.75.0",
    "@payloadcms/plugin-ecommerce": "^3.75.0",
    "@payloadcms/plugin-seo": "^3.75.0",
    "@payloadcms/richtext-lexical": "^3.75.0",
    "@payloadcms/storage-vercel-blob": "^3.75.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@tanstack/react-form": "^1.28.0",
    "@types/leaflet": "^1.9.21",
    "@types/leaflet-draw": "^1.0.13",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^25.2.1",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@vite-pwa/assets-generator": "^1.0.2",
    "better-auth": "^1.4.18",
    "concurrently": "^9.2.1",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.1.6",
    "geojson": "^0.5.0",
    "graphql": "^16.12.0",
    "openapi-types": "^12.1.3",
    "payload": "^3.75.0",
    "payload-auth": "^1.8.4",
    "sharp": "^0.34.5",
    "stripe": "^20.3.1",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.2",
    "zod": "^4.3.6"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
