{
  "$schema": "https://ui.shadcn.com/schema.json",
  "style": "new-york",
  "rsc": true,
  "tsx": true,
  "tailwind": {
    "config": "",
    "css": "src/app/themes/default.css",
    "baseColor": "neutral",
    "cssVariables": true,
    "prefix": ""
  },
  "iconLibrary": "lucide",
  "rtl": true,
  "aliases": {
    "components": "@/components",
    "utils": "@/lib/utils",
    "ui": "@/components/ui",
    "lib": "@/lib",
    "hooks": "@/hooks"
  },
  "registries": {
    "@magicui": "https://magicui.design/r/{name}",
    "@react-bits": "https://reactbits.dev/r/{name}.json",
    "@animate-ui": "https://animate-ui.com/r/{name}.json",
    "@animbits": "https://animbits.dev/r/{name}.json",
    "@commercn": "https://commercn.com/r/{name}.json",
    "@motion-primitives": "https://motion-primitives.com/c/{name}.json",
    "@shadcn-map": "http://shadcn-map.vercel.app/r/{name}.json",
    "@tweakcn": "https://tweakcn.com/r/themes/{name}.json"
  }
}
