# ═══════════════════════════════════════════════════════════════════════════════
# SaaSTARTER — Environment Variables
# ═══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in the values.
#   cp .env.example .env
#
# NEVER commit .env with real values — it is gitignored.
# See .claude/skills/deploy-setup/SKILL.md for full setup instructions.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Secrets (REQUIRED) ────────────────────────────────────────────────────────
# Generate unique 64-char hex strings. Example:
#   openssl rand -hex 32
PAYLOAD_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32
BETTER_AUTH_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32

# ── Site URL (REQUIRED) ──────────────────────────────────────────────────────
# Local development: http://localhost:3000
# Production: https://yourdomain.com (must match your Vercel domain)
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# ── Database (REQUIRED) ──────────────────────────────────────────────────────
# Local development — SQLite (zero setup, just works):
DATABASE_URL=file:./sqlite-data/saastarter.db

# Production — Turso (libSQL remote database):
# Sign up at https://turso.tech, then:
#   turso db create your-project
#   turso db show your-project --url
#   turso db tokens create your-project
# DATABASE_URL=libsql://your-db-name-your-org.turso.io
# DATABASE_AUTH_TOKEN=your_turso_auth_token

# Alternative Turso variable names (used as fallback):
# TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
# TURSO_AUTH_TOKEN=your_turso_auth_token

# Push schema to DB on startup (set to "true" for first deploy, then remove)
PAYLOAD_SCHEMA_PUSH=true

# ── Resend (REQUIRED — all transactional emails) ────────────────────────────
# Sign up at https://resend.com, create an API key
# Free tier: 100 emails/day — sufficient for development
RESEND_API_KEY=re_...

# Optional: sync newsletter subscribers to a Resend audience
# RESEND_AUDIENCE_ID=your-audience-uuid

# ── Stripe (REQUIRED for payments) ───────────────────────────────────────────
# Get from https://dashboard.stripe.com/apikeys
# Use test keys (pk_test_, sk_test_) for development
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── SaaSignal (REQUIRED — powers search, analytics, and background jobs) ────
# Sign up at https://saasignal.com, create a project, generate a token
SAASIGNAL_TOKEN=sk_live_...

# Optional SaaSignal overrides (defaults are fine for most projects):
# SAASIGNAL_SEARCH_INDEX=products
# SAASIGNAL_RANKING_COLLECTION=products

# ── Google OAuth (optional — enables Google sign-in) ─────────────────────────
# Set up at https://console.cloud.google.com/apis/credentials
# Both must be set to enable Google login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Vercel Blob Storage (optional — for media uploads in production) ─────────
# Auto-set when you run: vercel blob create-store your-project
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

